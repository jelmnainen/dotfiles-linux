* {
  bg-col:       #1d2021;
  bg-col-light: #282828;
  border-col:   #a9b665;
  selected-col: #3c3836;
  fg-col:       #fbf1c7;
  fg-col2:      #928374;

  font: "JetBrainsMono Nerd Font";
  background-color: transparent;
}

window {
    width: 50%;
    border: 2px solid;
    border-color: @border-col;
    background-color: @bg-col;
    border-radius: 12px;
  }

mainbox {
    padding: 20px;
    background-color: @bg-col;
}

inputpar {
    children: [prompt, entry];
    background-color: @bg-col-light;
    border-radius: 8px;
    padding: 8px;
  }

prompt {
    background-color: @border-col;
    text-col: @bg-col;
    padding: 6px 12px;
    border-radius: 6px;
    margin: 0px 10px 0px 0px;
  }

entry {
    padding: 6px;
    text-col: @fg-col;
    placeholder: "Search...";
    placeholder-color: @fg-col2;
  }

listview {
    column: 1;
    lines: 1;
    padding: 15px 0px 0px 0px;
    spacing: 5px;
  }

element {
    padding: 10px;
    text-color: @fg-col2;
    border-radius: 8px;
  }

element-icon {
    size: 28px;
    margin: 0px 15px 0px 0px;
  }

element-text {
  vertical-align: 0.5;
  text-color: inherit;
  }

element selected {
    background-color: @selected-col;
    text-color: @fg-col;
  }
